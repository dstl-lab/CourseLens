# backend/.env.example

# The folder that holds your course materials. Use the full path (relative
# paths are resolved from this backend folder). Optional settings for the
# course go in a courselens.json inside that folder; see
# docs/courselens-config.md.
COURSE_REVIEW_ROOT=/path/to/your/course

# The address you open CourseLens at in your browser.
ALLOWED_ORIGINS=http://localhost:5173
